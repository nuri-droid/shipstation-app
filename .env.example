# Copy this file to .env and fill in the values.

# 1 = sample data, no API calls (good for trying the screens). 0 = real data.
MOCK_MODE=1
SECRET_KEY=change-me

# ShipStation V1 (orders) - same key/secret as NoAssignExportAwaitingShipments
SS_V1_KEY=
SS_V1_SECRET=
# ShipStation V2 (rates) - same key as getShipStationRatesOnDashboardV2
SS_V2_KEY=

# FedEx - same values as the FedEx Apps Script
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT=

# Google service account JSON (for stock, aisle locations, landed cost, titles).
# Share each sheet below with the service account's e-mail as Viewer.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
FINALE_SHEET_ID=1zEIt6C3DD-7frRK4NtxfxQJuS-p1jveifhEjUljFNVM
AISLE_IL_SHEET_ID=1PUPq-IHGhMJ91JOcmUjQ19N3xji2lh57dkpbW4uNB1M
AISLE_TX_SHEET_ID=1Ji5Q_NMctR5HP4_Wkv7Xu0PmS1n8O5QW4QDjpCC8Q1c
AISLE_CA_SHEET_ID=1MjJW0RbHGmIU5umamJTlH4Cs5Ql9TPWNvnCd8z_lzQk
COST_SHEET_ID=13HPSNm_L462L8nB_gZpY0we4RyFVW0IdSYzuqhgTXEw
SELLWARE_SHEET_ID=1-718OPciXx0kZ2UO4gZ286-kvdFNnN2h4n_8FWCJ3fo

# Warehouse assignment compares "cheapest" (UPS + FedEx) or "ups" only
ASSIGN_USING=cheapest
# Rates are cached per package for this many hours, so a refresh only asks for new orders
RATE_CACHE_HOURS=12
